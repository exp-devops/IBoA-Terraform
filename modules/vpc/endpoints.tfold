# Security group for VPC endpoints
resource "aws_security_group" "vpc_endpoint_sg" {
  name        = "${var.project_name}-${var.project_segment}-${var.project_env}-vpc-endpoint-sg"
  description = "Security group for VPC endpoints"
  vpc_id      = aws_vpc.tf_vpc.id

  ingress {
    from_port   = 443
    to_port     = 443
    protocol    = "tcp"
    cidr_blocks = [var.network_cidr]
    description = "Allow HTTPS from VPC CIDR for VPC endpoints"
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
    description = "Allow all outbound traffic"
  }

  tags = merge(
    local.common_tags,
    tomap({
      Name = "${var.project_name}-${var.project_segment}-${var.project_env}-vpc-endpoint-sg"
    })
  )
}

# Associate VPC endpoint with private route table
resource "aws_vpc_endpoint_route_table_association" "private_s3_endpoint" {
  vpc_endpoint_id = aws_vpc_endpoint.s3.id
  route_table_id = aws_route_table.tf_private_rt.id
}